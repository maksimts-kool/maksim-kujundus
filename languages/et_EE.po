msgid "Leave a Comment<span class=\"screen-reader-text\"> on %s</span>"
msgstr "Jäta kommentaar<span class=\"screen-reader-text\"> teemale %s</span>"

#. translators: %s: post date.
msgctxt "post date"
msgid "Posted on %s"
msgstr "Postitatud %s"

#. translators: %s: post author.
msgctxt "post author"
